/* Extracted production retirement/drain functions with authored adapters. */
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "rsx_record_batch.h"
#include "rsx_renderer_phase.h"
/* Renderer phase accounting (RSX_CPU_SURFACE_PROFILE=1) is a no-op here. */
void rsx_d3d12_renderer_phase_begin(unsigned phase) { (void)phase; }
void rsx_d3d12_renderer_phase_end(void) {}
void rsx_d3d12_renderer_phase_submit_stage(unsigned phase) { (void)phase; }
typedef uint32_t u32; typedef uint64_t u64; typedef int32_t HRESULT;
#define S_OK 0
#define MAX_DRAWS 4
struct Device; struct Fence;
struct DeviceOps { HRESULT (*GetDeviceRemovedReason)(struct Device*); };
struct FenceOps { u64 (*GetCompletedValue)(struct Fence*); };
struct Device { struct DeviceOps* lpVtbl; }; struct Fence { struct FenceOps* lpVtbl; };
static struct { struct Device* device; struct Fence* fence; u64 fence_values[2]; u32 frame_index,draw_count; } s_d3d;
static int mode, waits, renders, last_render_wait, overlap, s_present_this_frame=1;
static int drain_overlap(void) { return overlap; }
static void cpu_surface_flush_recorded(int at_pump) { (void)at_pump; }   /* early CPU-read submission: no queued reads here */
static HRESULT removed(struct Device* d) { (void)d; int m = mode >= 5 && waits == 2 ? mode - 4 : mode < 5 ? mode : 0; return m==2 ? -1 : m==3 ? 1 : 0; }
static u64 completed(struct Fence* f) { (void)f; int m = mode >= 5 && waits == 2 ? mode - 4 : mode < 5 ? mode : 0; return m==1 ? s_d3d.fence_values[s_d3d.frame_index]-1 : m==4 ? UINT64_MAX : s_d3d.fence_values[s_d3d.frame_index]; }
static int wait_for_gpu(void) { ++waits; ++s_d3d.fence_values[s_d3d.frame_index]; return !(mode==9 || (mode==10 && waits==2)); }
/* Replay only after a retirement since the previous replay: at most one batch in flight. */
static void render_frame(void) { if (s_present_this_frame || waits == last_render_wait) abort(); last_render_wait = waits; ++renders; s_d3d.draw_count=0; }
@FUNCTIONS@
int main(int argc,char**argv) {
 struct DeviceOps dv={removed}; struct Device d={&dv}; struct FenceOps fv={completed}; struct Fence f={&fv};
 s_d3d.device=&d; s_d3d.fence=&f; mode=argc>1?atoi(argv[1]):0; s_d3d.draw_count=MAX_DRAWS;
 for(int i=2;i<argc;++i){ if(!strcmp(argv[i],"frame1")) s_d3d.frame_index=1; if(!strcmp(argv[i],"overlap")) overlap=1; }
 ensure_draw_record_capacity();
 if(overlap){ /* the next batch fills while the first may still run */
  if(waits!=1||renders!=1) return 3;
  s_d3d.draw_count=MAX_DRAWS; ensure_draw_record_capacity();
  if(mode||waits!=2||renders!=2||s_present_this_frame!=1||s_d3d.draw_count) return 2;
  puts("PASS: overlapped drains retire the previous batch before each replay, never after it"); return 0; }
 if(mode||waits!=2||renders!=1||s_present_this_frame!=1||s_d3d.draw_count) return 2;
 puts("PASS: capacity drain checks retirement before and after submission without present"); return 0;
}
